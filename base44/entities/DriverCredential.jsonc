{
  "name": "DriverCredential",
  "type": "object",
  "properties": {
    "driver_id": {
      "type": "string",
      "description": "ID do motorista"
    },
    "driver_name": {
      "type": "string",
      "description": "Nome do motorista (cache)"
    },
    "email": {
      "type": "string",
      "description": "Email do motorista"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash bcrypt da senha (nunca armazenar em texto plano)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Status do acesso"
    },
    "allowed_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "ActiveTrips",
        "CompletedTrips",
        "Earnings"
      ],
      "description": "P\u00e1ginas que o motorista pode acessar"
    }
  },
  "required": [
    "driver_id",
    "email",
    "password_hash"
  ],
  "rls": {}
}