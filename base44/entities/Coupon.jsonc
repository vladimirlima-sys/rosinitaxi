{
  "name": "Coupon",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Code unique du coupon (ex: PROMO10)"
    },
    "discount_percentage": {
      "type": "number",
      "default": 10,
      "description": "Pourcentage de r\u00e9duction"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si le coupon est actif (peut \u00eatre d\u00e9sactiv\u00e9 par l'admin)"
    },
    "used_by_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Liste des emails qui ont d\u00e9j\u00e0 utilis\u00e9 ce coupon"
    },
    "used_count": {
      "type": "number",
      "default": 0,
      "description": "Nombre total d'utilisations"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Date d'expiration (optionnel)"
    }
  },
  "required": [
    "code",
    "discount_percentage"
  ],
  "rls": {}
}